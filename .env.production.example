# GALILEO production secrets — copy to .env and fill in real values.
# Generate secrets with:  openssl rand -hex 32

# Public hostname (DNS A record must point at this VM). Use
# ":80" only for a local plain-HTTP validation run.
DOMAIN=galileo.example.com
ACME_EMAIL=you@example.com

# REQUIRED - no fallbacks in production
JWT_SECRET=

# Datastore credentials (dev fallbacks exist but MUST be overridden)
DB_PASSWORD=
REDIS_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: enables the Cesium Ion 3D-buildings layer on the globe
CESIUM_ION_TOKEN=
