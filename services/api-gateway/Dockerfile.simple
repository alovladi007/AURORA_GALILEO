FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY services/api-gateway/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy proto files from root
COPY proto/ ./proto/

# Create gen directory and generate protobuf code
RUN mkdir -p gen
RUN python -m grpc_tools.protoc \
    --proto_path=proto \
    --python_out=gen \
    --grpc_python_out=gen \
    proto/*.proto

# Create __init__.py
RUN touch gen/__init__.py

# Copy gateway application
COPY services/api-gateway/enhanced-gateway.py ./app.py

# Add gen directory to PYTHONPATH
ENV PYTHONPATH="/app/gen:${PYTHONPATH}"

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run application
CMD ["python", "app.py"]
