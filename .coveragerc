# Coverage configuration (moved out of pytest.ini, where [coverage:*]
# sections broke [pytest] key parsing). Enable with: pytest --cov=<pkg>
[run]
omit =
    */tests/*
    */test_*.py
    */__pycache__/*

[report]
precision = 2
skip_empty = True
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:

[html]
directory = htmlcov
