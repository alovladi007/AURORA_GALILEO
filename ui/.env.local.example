# Cesium Ion Access Token
# Get your token at: https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=your_token_here

# API Gateway URL - Connects to all microservices (Data, ML, Inversion, Control)
# Development: Port 18000 (alternative port to avoid conflicts)
# Production: Use your domain (e.g., https://api.galileo.example.com)
NEXT_PUBLIC_API_URL=http://localhost:18000

# Operations API URL (same as API Gateway)
NEXT_PUBLIC_OPS_API_URL=http://localhost:18000

# NextAuth Configuration
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# API Gateway Base Path (if behind reverse proxy)
NEXT_PUBLIC_API_BASE_PATH=/api/v1
