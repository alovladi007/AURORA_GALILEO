# GALILEO Microservices Environment Configuration
# Copy this file to .env.microservices and fill in the values

# Database
DB_PASSWORD=galileo_password_change_me

# Redis
REDIS_PASSWORD=redis_password_change_me

# MinIO / S3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_password_change_me

# JWT Authentication
JWT_SECRET=jwt_secret_key_change_me_to_random_string

# Grafana
GRAFANA_PASSWORD=admin_password_change_me

# Service Ports (for reference)
# API Gateway: 8000
# Data Service: 50051 (gRPC)
# ML Service: 50052 (gRPC)
# Inversion Service: 50053 (gRPC)
# Control Service: 50054 (gRPC)
# Operations Service: 50055 (gRPC)

# PostgreSQL: 5432
# Redis: 6379
# MinIO: 9000 (API), 9001 (Console)
# Kafka: 9092
# Jaeger UI: 16686
# MLflow: 5000
# Prometheus: 9090
# Grafana: 3001
